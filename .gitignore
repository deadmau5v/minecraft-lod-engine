target/
**/*.rs.bk
*.pdb

# SQLite databases & journals
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db
*.db-wal
*.db-shm

# Caches and runtime scratch directories
cache/
.cache/
lod_cache/
output/
tmp/
temp/
job_*/
*.tmp
*.log

# Compressed archives & map data dumps
*.zip
*.tar
*.tar.gz
*.tar.xz
*.mca
*.nbt

# Script and interpreter artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# Operating system & Editor configuration
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
